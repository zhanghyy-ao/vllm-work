# Browser agent identity
BROWSER_AGENT_NAME=browser-workflow-agent

# The planning model uses an OpenAI-compatible chat/completions endpoint.
BROWSER_AGENT_PROVIDER=openai_compatible
BROWSER_AGENT_MODEL=gpt-5.5
BROWSER_AGENT_MODEL_FALLBACKS=gpt-5.4,gpt-5.4-mini
BROWSER_AGENT_API_BASE_URL=https://synai996.space/v1
BROWSER_AGENT_API_KEY_ENV=BROWSER_AGENT_API_KEY
BROWSER_AGENT_USE_LLM=true
# Put your real key in .env or shell environment, not in this file.
BROWSER_AGENT_API_KEY=

# Multimodal planning uses the same OpenAI-compatible model with screenshots.
BROWSER_AGENT_VISION_PROVIDER=openai_compatible
BROWSER_AGENT_VISION_MODEL=gpt-5.5
BROWSER_AGENT_VISION_MODEL_FALLBACKS=gpt-5.4,gpt-5.4-mini
BROWSER_AGENT_VISION_API_BASE_URL=https://synai996.space/v1
BROWSER_AGENT_VISION_API_KEY_ENV=BROWSER_AGENT_API_KEY
BROWSER_AGENT_HTTP_USER_AGENT=codex-browser-agent/1.0
BROWSER_AGENT_LLM_TIMEOUT_SEC=30
BROWSER_AGENT_VISION_TIMEOUT_SEC=30
BROWSER_AGENT_PLANNER_MAX_TOKENS=1000
BROWSER_AGENT_REPORT_MAX_TOKENS=1600
BROWSER_AGENT_REPORT_RETRY_MAX_TOKENS=900
BROWSER_AGENT_USE_MULTIMODAL_PLANNING=true
BROWSER_AGENT_USE_VISUAL_PRECHECK=false
