# Browser agent identity
BROWSER_AGENT_NAME=browser-workflow-agent

# DeepSeek is OpenAI-compatible and is the default LLM provider for this MVP.
BROWSER_AGENT_PROVIDER=deepseek
BROWSER_AGENT_MODEL=deepseek-chat
BROWSER_AGENT_API_BASE_URL=https://api.deepseek.com
BROWSER_AGENT_API_KEY_ENV=DEEPSEEK_API_KEY
BROWSER_AGENT_USE_LLM=true

# Put your real key in .env or shell environment, not in this file.
DEEPSEEK_API_KEY=

# Optional future multimodal vision/video understanding provider.
BROWSER_AGENT_VISION_PROVIDER=gemini
BROWSER_AGENT_VISION_MODEL=gemini-1.5-flash
BROWSER_AGENT_VISION_API_KEY_ENV=GEMINI_API_KEY
GEMINI_API_KEY=
