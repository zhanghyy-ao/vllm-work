{
  "manifest_version": 3,
  "name": "Browser Copilot Agent",
  "version": "0.1.1",
  "description": "Run local Browser Copilot Agent from Chrome popup.",
  "action": {
    "default_title": "Browser Copilot Agent",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
